{
  "manifest_version": 3,
  "name": "e-Diary SPRM Auto",
  "version": "1.0",
  "description": "Pembantu pengisian e-Diary SPRM automatik",
  "permissions": ["storage"],
  "action": {
    "default_title": "e-Diary SPRM Auto"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ediary.sprm.gov.my/aktiviti/tambah*",
        "https://ediary.sprm.gov.my/aktiviti/papar*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
